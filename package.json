{
  "name": "dsh-ui-tools",
  "version": "0.4.32",
  "description": "DSH Web UI 工具集：模型选择双按钮、工作区折叠/展开、会话工作区徽章、插件设置页、可拖动输出速度计胶囊、列表右键菜单（删除会话/工作区）、待办进度面板。只改界面，不改内核源码。",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "check": "node --check lib/client.js && node tools/check-hooks-order.mjs && node tools/check-model-seat-hug.mjs && node tools/check-context-menu.mjs && node tools/check-profile-drift.mjs && node tools/compat-check.mjs && node tools/live-smoke.mjs"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "dsh": "^0.1.1-0 || ^0.1.2-0 || ^0.1.3-0 || ^0.1.5-0 || ^0.1.6-0 || ^0.1.7-0 || ^0.2.0-0 || >=0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    },
    "engines": {
      "dsh": "^0.1.1-0 || ^0.1.2-0 || ^0.1.3-0 || ^0.1.5-0 || ^0.1.6-0 || ^0.1.7-0 || ^0.2.0-0 || >=0.3.0-0"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qgx1992/dsh-ui-tools.git"
  },
  "homepage": "https://github.com/qgx1992/dsh-ui-tools#readme",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "web",
    "ui",
    "model-select",
    "provider",
    "workspace",
    "collapse",
    "client-plugin",
    "token-speed",
    "tokens-per-second",
    "zh",
    "en",
    "context-menu",
    "right-click",
    "session-menu"
  ],
  "license": "MIT"
}
